    {
      "parameters": {
        "jsCode": "// Sample data from this repo. Click 'Test workflow' to run the whole flow on it.\nconst sample = [\n {\n  \"device\": \"farm-1\",\n  \"s1\": 30,\n  \"s2\": 31,\n  \"s3\": 29,\n  \"crop_day\": 6,\n  \"forecast_mm\": 0\n },\n {\n  \"device\": \"farm-1\",\n  \"s1\": 30,\n  \"s2\": 31,\n  \"s3\": 29,\n  \"crop_day\": 6,\n  \"forecast_mm\": 12\n },\n {\n  \"device\": \"farm-2\",\n  \"s1\": 10,\n  \"s2\": 10,\n  \"s3\": 90,\n  \"crop_day\": 2,\n  \"forecast_mm\": 0\n },\n {\n  \"device\": \"farm-3\",\n  \"s1\": 55,\n  \"s2\": 54,\n  \"s3\": 56,\n  \"crop_day\": 11,\n  \"forecast_mm\": 0\n }\n];\nreturn sample.map(json => ({ json }));"
      },
      "id": "c9115ea1-8b55-5d49-be22-5a54d3064632",
      "name": "Sample data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// Smart Irrigation Controller (ESP32): core logic (ported from main.py)\n\n// ---- input normaliser (works for Webhook, Form, WhatsApp, Gmail, Sheets and sample data)\nconst input = $input.all().flatMap(i => {\n  const j = i.json || {};\n  if (j.messages && Array.isArray(j.messages)) {           // WhatsApp Trigger\n    return j.messages.filter(m => m.text).map(m => ({ from: '+' + m.from, text: m.text.body }));\n  }\n  if (j.Subject !== undefined || j.From !== undefined) {     // Gmail Trigger (simple)\n    return [{ from: (j.From || '').replace(/.*<|>.*/g, ''), subject: j.Subject || '', body: j.snippet || j.text || '' }];\n  }\n  const b = (j.body !== undefined && j.headers !== undefined) ? j.body : j;   // Webhook wraps payload in body\n  if (Array.isArray(b)) return b;\n  if (b && Array.isArray(b.items)) return b.items;\n  return [b];\n});\n\nconst STAGES = [[0, 4, 45], [5, 9, 38], [10, 13, 42]], MAX_RUN = 20, PER_POINT = 0.8, OFFSET = 12, RAIN_SKIP = 5, FARMER = '+2348000000000';\nreturn input.map(r => {\n  const s = [r.s1, r.s2, r.s3].map(Number).sort((a, b) => a - b), m = s[1];\n  const th = (STAGES.find(([a, b]) => r.crop_day >= a && r.crop_day <= b) || STAGES[STAGES.length - 1])[2];\n  let minutes = 0, reason;\n  if (m >= th) reason = `moist enough (${m}% >= ${th}%)`;\n  else if (Number(r.forecast_mm || 0) >= RAIN_SKIP) reason = `dry (${m}%) but ${r.forecast_mm} mm rain forecast`;\n  else { minutes = Math.min(MAX_RUN, Math.round((th + OFFSET - m) * PER_POINT)); reason = `dry (${m}% < ${th}%), watering ${minutes} min`; }\n  return { json: { route: minutes ? 'watering' : 'log', device: r.device, median: m, threshold: th, valve_min: minutes, reason, to: FARMER,\n    message: `${r.device}: ${reason}`, at: new Date().toISOString() } };\n});\n"
      },
